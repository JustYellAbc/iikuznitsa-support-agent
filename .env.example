# Шаблон переменных окружения. Скопируйте в .env и заполните. .env в git не коммитим.

# --- LLM (любой OpenAI-совместимый API) ---
# true — оффлайн-режим без сети и без трат: ответ-заглушка, токены оцениваются по длине текста
MOCK_LLM=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Необязательный HTTP(S)/SOCKS-прокси на случай геоблока РФ-IP, например http://user:pass@host:3128
LLM_PROXY_URL=
LLM_TIMEOUT_S=60

# Профили моделей: SMART — основной цикл агента, FAST — суммаризация эскалации и патчи БЗ
MODEL_SMART=gpt-4.1
MODEL_FAST=gpt-4.1-mini
# Цены провайдера в USD за 1M токенов. Сверьте с прайсом выбранных моделей.
MODEL_SMART_PRICE_IN_USD=2.00
MODEL_SMART_PRICE_OUT_USD=8.00
MODEL_FAST_PRICE_IN_USD=0.40
MODEL_FAST_PRICE_OUT_USD=1.60
# Курс ЦБ РФ на 25.11.2026
USD_RUB_RATE=82.1664

# --- Лимиты стенда ---
DAILY_BUDGET_RUB=500
BUDGET_TZ=Europe/Moscow
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_SESSION_MSG_PER_MIN=10
MAX_TURNS_PER_SESSION=30
MAX_MESSAGE_CHARS=4000

# --- Вход менеджера (POST /api/v1/auth/manager/login -> cookie support_session) ---
# Пустой пароль закрывает вход менеджера полностью
OPERATOR_USER=manager
OPERATOR_PASSWORD=
MANAGER_SESSION_HOURS=12
CUSTOMER_SESSION_HOURS=720

# --- Прочее ---
# Через запятую. * — разрешить любой сайт (виджет без cookies)
CORS_ORIGINS=*
# Публичный HTTPS-адрес этого экземпляра для ссылок на опубликованные статьи.
PUBLIC_BASE_URL=https://139-100-217-243.sslip.io
DATA_DIR=./data
# pilot — ответы агента уходят менеджеру черновиками; autopilot — сразу клиенту
DEFAULT_MODE=autopilot

# --- Сборка образа ---
# Зеркало Debian для apt внутри образа, если deb.debian.org недоступен (пример: http://mirror.selectel.ru/debian)
DEBIAN_MIRROR=
