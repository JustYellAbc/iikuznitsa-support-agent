# Конфигурация тарифов для воспроизводимого расчёта стоимости запроса (T19).
#
# Инструкция:
#   1. Скопируйте этот файл в config/pricing.yaml (он в .gitignore).
#   2. Заполните ВСЕ обязательные поля актуальными данными из официальных прайсов.
#   3. Значений по умолчанию в коде нет: при отсутствии или пустоте любого поля
#      scripts/calc_unit_economics.py завершится с ошибкой.
#   4. Ссылки (source_url) и даты фиксации (date, YYYY-MM-DD) обязательны для
#      каждой модели, инфраструктуры и оценки оператора.

models:
  # Замените ключ на точное имя модели из телеметрии / отчёта eval
  # (например, как оно записано в llm_calls.model или trace steps[].args.model).
  replace-with-model-id:
    # Цена за 1 000 000 входных токенов (число >= 0, без валютного знака).
    input_per_1m:
    # Цена за 1 000 000 выходных токенов (число >= 0, без валютного знака).
    output_per_1m:
    # Валюта прайса: "USD" или "RUB".
    currency: ""
    # Прямая ссылка на официальный прайс-лист провайдера (https://...).
    source_url: ""
    # Дата фиксации прайса в формате YYYY-MM-DD.
    date: ""

infrastructure:
  # Суточная стоимость инфраструктуры стенда (VPS/сервер, прокси и т.п., число >= 0).
  daily_cost:
  # Валюта тарифа инфраструктуры: "RUB" или "USD".
  currency: ""
  # Ссылка на тариф хостинга или обоснование расчёта (https://...).
  source_url: ""
  # Дата фиксации тарифа в формате YYYY-MM-DD.
  date: ""
  # Необязательное краткое описание конфигурации (например, провайдер и параметры VPS).
  description: ""

operator:
  # Полная стоимость часа работы оператора поддержки в рублях (число > 0).
  hourly_rate_rub:
  # Среднее время обработки одного обращения оператором в минутах (число > 0).
  minutes_per_request:
  # Ссылка на источник оценки ФОТ / времени оператора (https://... или ссылка на документ).
  source_url: ""
  # Дата фиксации оценки в формате YYYY-MM-DD.
  date: ""
